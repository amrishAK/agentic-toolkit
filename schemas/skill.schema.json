{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-toolkit.dev/schemas/1.0.0/skill.schema.json",
  "title": "Agent Skills frontmatter",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "string",
      "minLength": 1
    },
    "allowed-tools": {
      "type": "string",
      "minLength": 1
    }
  }
}
